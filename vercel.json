{
  "buildCommand": "next build",
  "framework": "nextjs",
  "functions": {
    "src/app/api/stream/route.ts":    { "maxDuration": 30 },
    "src/app/api/search/route.ts":    { "maxDuration": 30 },
    "src/app/api/trending/route.ts":  { "maxDuration": 30 },
    "src/app/api/related/route.ts":   { "maxDuration": 30 },
    "src/app/api/lyrics/route.ts":    { "maxDuration": 15 },
    "src/app/api/podcasts/route.ts":  { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
